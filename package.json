{
  "name": "crm-nutricionista",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "check": "npm run build && npm test && npm audit --omit=dev"
  },
  "dependencies": {
    "@prisma/client": "7.9.1",
    "bcryptjs": "^3.0.3",
    "compression": "1.8.1",
    "dotenv": "17.2.1",
    "ejs": "3.1.10",
    "express": "5.1.0",
    "express-ejs-layouts": "2.5.1",
    "express-session": "^1.19.0",
    "helmet": "8.1.0",
    "pg": "8.16.3",
    "pino": "9.9.4",
    "pino-http": "10.5.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.3",
    "@types/express-ejs-layouts": "2.5.4",
    "@types/express-session": "^1.19.0",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "playwright-core": "1.62.1",
    "prisma": "7.9.1",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true
  }
}
