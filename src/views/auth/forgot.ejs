<!doctype html><html lang="pt-BR"><head><%- include('../partials/head', { pageTitle }) %></head><body class="auth-page"><main class="auth-simple"><a href="/login">← Voltar</a><section class="auth-card"><header><p class="eyebrow">RECUPERAÇÃO LOCAL</p><h2>Recuperar senha</h2><p>Informe o e-mail da conta.</p></header><% if (errorMessage) { %><div class="auth-error"><%= errorMessage %></div><% } %><% if (typeof submitted !== 'undefined') { %><div class="auth-notice">Se a conta existir, o link foi gerado.</div><% } %><form method="post" action="/forgot-password"><label class="form-field"><span>E-mail</span><input name="email" type="email" required></label><button class="button button-primary" type="submit">Gerar link</button></form><% if (resetUrl) { %><a class="button button-secondary" href="<%= resetUrl %>">Abrir link de redefinição</a><small class="local-only-note">Este link é exibido somente no ambiente local; em produção será enviado por e-mail.</small><% } %></section></main></body></html>
