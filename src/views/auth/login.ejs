<!doctype html><html lang="pt-BR"><head><%- include('../partials/head', { pageTitle }) %></head><body class="auth-page"><main class="auth-shell"><section class="auth-brand"><div class="brand-mark">CRM</div><p class="eyebrow">CRM NUTRICIONISTA</p><h1>Cuidado clínico organizado, do consultório ao paciente.</h1><p>Ambiente local protegido para administrar prontuários, dietas, agenda e acompanhamento.</p><div><small>ACESSO DE TESTE</small><code>marina@consultorio.local · Nutri@2026</code><code>ana@example.local · Paciente@2026</code></div></section><section class="auth-card"><header><p class="eyebrow">ACESSO SEGURO</p><h2>Entrar no sistema</h2><p>Use seu e-mail e sua senha.</p></header><% if (errorMessage) { %><div class="auth-error"><%= errorMessage %></div><% } %><% if (notice) { %><div class="auth-notice"><%= notice === 'logout' ? 'Sessão encerrada com segurança.' : 'Senha atualizada. Entre novamente.' %></div><% } %><form method="post" action="/login"><label class="form-field"><span>E-mail</span><input name="email" type="email" autocomplete="username" required></label><label class="form-field"><span>Senha</span><input name="password" type="password" autocomplete="current-password" required></label><button class="button button-primary" type="submit">Entrar</button></form><a href="/forgot-password">Esqueci minha senha</a></section></main></body></html>
