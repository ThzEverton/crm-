<section class="module-heading">
  <div><p class="eyebrow"><%= selectedModule.phase %></p><h1><%= selectedModule.title %></h1><p><%= selectedModule.description %></p></div>
  <% if (moduleKey === 'patients') { %><button class="button button-primary" type="button" data-dialog-open="new-patient">＋ Adicionar paciente</button><% } %>
  <% if (moduleKey === 'diets') { %><button class="button button-primary" type="button" data-dialog-open="new-plan">＋ Novo plano</button><% } %>
  <% if (moduleKey === 'foods') { %><button class="button button-primary" type="button" data-dialog-open="new-food">＋ Novo alimento</button><% } %>
  <% if (moduleKey === 'agenda') { %><button class="button button-primary" type="button" data-dialog-open="new-appointment">＋ Nova consulta</button><% } %>
  <% if (moduleKey === 'finance') { %><button class="button button-primary" type="button" data-dialog-open="new-payment">＋ Novo lançamento</button><% } %>
  <% if (moduleKey === 'documents') { %><button class="button button-primary" type="button" data-dialog-open="new-document">＋ Novo documento</button><% } %>
</section>

<section class="panel module-preview">
  <% if (moduleKey === 'patients') { %>
    <div class="module-toolbar"><label><span>⌕</span><input type="search" placeholder="Buscar por nome..." data-patient-search></label><button class="module-filter active">Todos <b>5</b></button><button class="module-filter">Precisam de atenção <b>2</b></button></div>
    <div class="patient-preview-grid">
      <% patients.forEach((patient, index) => { const initials = patient.fullName.split(' ').slice(0, 2).map((name) => name[0]).join('').toUpperCase(); const tones = ['green','blue','peach','purple','sand']; %>
        <article class="patient-preview-card" data-patient-name="<%= patient.fullName.toLowerCase() %>"><span class="patient-avatar <%= tones[index % tones.length] %>"><%= initials %></span><i class="patient-status-<%= patient.status %>"><%= patient.status === 'inactive' ? 'Inativo' : patient.status === 'attention' ? 'Atenção' : 'Ativo' %></i><h2><%= patient.fullName %></h2><p><%= patient.goal %></p><div><span><small>ADESÃO</small><b><%= patient.adherence %>%</b></span><span><small>PLANO</small><b><%= patient.plan %></b></span></div><button type="button" data-dialog-open="patient-<%= patient.id %>">Abrir prontuário →</button></article>

        <dialog class="app-dialog patient-dialog" id="patient-<%= patient.id %>" aria-labelledby="patient-<%= patient.id %>-title">
          <div class="patient-dialog-shell">
            <header class="dialog-header"><div><p class="eyebrow">PRONTUÁRIO LOCAL</p><h2 id="patient-<%= patient.id %>-title"><%= patient.fullName %></h2></div><button class="dialog-close" type="button" data-dialog-close aria-label="Fechar">×</button></header>
            <div class="dialog-body">
              <div class="patient-dialog-hero"><span class="patient-avatar <%= tones[index % tones.length] %>"><%= initials %></span><div><strong><%= patient.goal %></strong><small><%= patient.email %> · <%= patient.phone %></small></div><b><%= patient.status === 'inactive' ? 'Inativo' : 'Acompanhamento ativo' %></b></div>
              <% const latestAssessment = patient.assessments[0]; %>
              <div class="clinical-summary">
                <div><small>PESO ATUAL</small><strong><%= latestAssessment ? latestAssessment.weightKg.toFixed(1).replace('.', ',') : '—' %> <em>kg</em></strong><span class="<%= patient.progressKg <= 0 ? 'positive' : '' %>"><%= patient.progressKg > 0 ? '+' : '' %><%= patient.progressKg.toFixed(1).replace('.', ',') %> kg</span></div>
                <div><small>IMC</small><strong><%= latestAssessment ? latestAssessment.bmi.toFixed(1).replace('.', ',') : '—' %></strong><span>Estimativa</span></div>
                <div><small>GORDURA</small><strong><%= latestAssessment?.bodyFatPercent ? latestAssessment.bodyFatPercent.toFixed(1).replace('.', ',') + '%' : '—' %></strong><span><%= latestAssessment?.fatMassKg ? latestAssessment.fatMassKg.toFixed(1).replace('.', ',') + ' kg' : 'Não informada' %></span></div>
                <div><small>MASSA MAGRA</small><strong><%= latestAssessment?.leanMassKg ? latestAssessment.leanMassKg.toFixed(1).replace('.', ',') : '—' %> <em>kg</em></strong><span>Calculada</span></div>
              </div>
              <dl class="patient-data-list"><div><dt>Nascimento</dt><dd><%= patient.birthDate.split('-').reverse().join('/') %></dd></div><div><dt>Altura</dt><dd><%= patient.heightCm ? patient.heightCm + ' cm' : 'Não informada' %></dd></div><div><dt>Peso inicial</dt><dd><%= patient.initialWeightKg ? patient.initialWeightKg + ' kg' : 'Não informado' %></dd></div><div><dt>Atividade</dt><dd><%= patient.activityLevel %></dd></div></dl>
              <section class="patient-notes"><small>OBSERVAÇÕES</small><p><%= patient.notes || 'Nenhuma observação registrada.' %></p></section>
              <section class="assessment-history"><header><div><small>EVOLUÇÃO</small><strong>Histórico de avaliações</strong></div><button class="button button-secondary" type="button" data-dialog-open="assessment-<%= patient.id %>">＋ Nova avaliação</button></header><div>
                <% patient.assessments.forEach((assessment) => { %><article><time><%= assessment.assessedOn.split('-').reverse().join('/') %></time><span><small>Peso</small><b><%= assessment.weightKg.toFixed(1).replace('.', ',') %> kg</b></span><span><small>IMC</small><b><%= assessment.bmi.toFixed(1).replace('.', ',') %></b></span><span><small>Gordura</small><b><%= assessment.bodyFatPercent ? assessment.bodyFatPercent.toFixed(1).replace('.', ',') + '%' : '—' %></b></span><i><%= assessment.protocol %></i></article><% }) %>
              </div></section>
            </div>
            <footer class="dialog-footer"><form method="post" action="/patients/<%= patient.id %>/status"><button class="button button-secondary" type="submit"><%= patient.status === 'inactive' ? 'Reativar paciente' : 'Inativar paciente' %></button></form><button class="button button-primary" type="button" data-dialog-close>Concluir</button></footer>
          </div>
        </dialog>

        <dialog class="app-dialog" id="assessment-<%= patient.id %>" aria-labelledby="assessment-<%= patient.id %>-title">
          <form method="post" action="/assessments">
            <input type="hidden" name="patientId" value="<%= patient.id %>">
            <header class="dialog-header"><div><p class="eyebrow">AVALIAÇÃO FÍSICA</p><h2 id="assessment-<%= patient.id %>-title"><%= patient.fullName %></h2></div><button class="dialog-close" type="button" data-dialog-close aria-label="Fechar">×</button></header>
            <div class="dialog-body">
              <div class="dialog-section-title"><span>01</span><div><strong>Medidas principais</strong><small>O IMC e as massas são calculados automaticamente.</small></div></div>
              <div class="form-grid"><label class="form-field"><span>Data</span><input name="assessedOn" type="date" value="2026-08-05" required></label><label class="form-field"><span>Protocolo</span><select name="protocol" required><option>Bioimpedância</option><option>Jackson & Pollock — 3 dobras</option><option>Jackson & Pollock — 7 dobras</option><option>Faulkner — validação pendente</option><option>Personalizado</option></select></label><label class="form-field"><span>Peso (kg)</span><input name="weightKg" type="number" min="1" max="500" step="0.1" value="<%= latestAssessment?.weightKg ?? patient.initialWeightKg ?? '' %>" required></label><label class="form-field"><span>Altura (cm)</span><input name="heightCm" type="number" min="30" max="260" step="0.1" value="<%= patient.heightCm ?? '' %>" required></label><label class="form-field"><span>Gordura corporal (%)</span><input name="bodyFatPercent" type="number" min="1" max="80" step="0.1"></label><label class="form-field"><span>Cintura (cm)</span><input name="waistCm" type="number" min="1" step="0.1"></label><label class="form-field"><span>Quadril (cm)</span><input name="hipCm" type="number" min="1" step="0.1"></label><label class="form-field"><span>Braço (cm)</span><input name="armCm" type="number" min="1" step="0.1"></label><label class="form-field form-span-2"><span>Observações</span><textarea name="notes" rows="4" maxlength="2000"></textarea></label></div>
            </div>
            <footer class="dialog-footer"><button class="button button-secondary" type="button" data-dialog-close>Cancelar</button><button class="button button-primary" type="submit">Salvar avaliação</button></footer>
          </form>
        </dialog>
      <% }) %>
    </div>
  <% } else if (moduleKey === 'agenda') { %>
    <% const activeAppointments = appointments.filter((item) => !['cancelled', 'completed'].includes(item.status)); %>
    <div class="ops-summary"><span><small>CONSULTAS CADASTRADAS</small><strong><%= appointments.length %></strong></span><span><small>ATIVAS</small><strong><%= activeAppointments.length %></strong></span><span><small>CONFIRMADAS</small><strong><%= appointments.filter((item) => item.status === 'confirmed').length %></strong></span></div>
    <div class="agenda-list">
      <% appointments.forEach((appointment) => { const patient = allPatients.find((item) => item.id === appointment.patientId); const statusLabels = { scheduled: 'Agendada', confirmed: 'Confirmada', completed: 'Concluída', cancelled: 'Cancelada', no_show: 'Não compareceu' }; %>
        <article><time><b><%= appointment.time %></b><small><%= appointment.date.split('-').reverse().join('/') %></small></time><span class="agenda-marker <%= appointment.status %>"></span><div><strong><%= patient?.fullName ?? 'Paciente não encontrado' %></strong><p><%= appointment.type %> · <%= appointment.mode === 'online' ? 'Online' : 'Presencial' %> · <%= appointment.durationMinutes %> min</p><small><%= appointment.notes || 'Sem observações.' %></small></div><i class="operation-status <%= appointment.status %>"><%= statusLabels[appointment.status] %></i><form class="row-actions" method="post" action="/appointments/<%= appointment.id %>/status"><select name="status" aria-label="Alterar status"><option value="confirmed">Confirmar</option><option value="completed">Concluir</option><option value="no_show">Não compareceu</option><option value="cancelled">Cancelar</option></select><button type="submit">Atualizar</button></form></article>
      <% }) %>
    </div>
    <dialog class="app-dialog" id="new-appointment" aria-labelledby="new-appointment-title"><form method="post" action="/appointments"><header class="dialog-header"><div><p class="eyebrow">AGENDA</p><h2 id="new-appointment-title">Nova consulta</h2></div><button class="dialog-close" type="button" data-dialog-close>×</button></header><div class="dialog-body"><div class="form-grid"><label class="form-field form-span-2"><span>Paciente</span><select name="patientId" required><option value="">Selecione</option><% allPatients.forEach((patient) => { %><option value="<%= patient.id %>"><%= patient.fullName %></option><% }) %></select></label><label class="form-field"><span>Data</span><input name="date" type="date" required></label><label class="form-field"><span>Horário</span><input name="time" type="time" required></label><label class="form-field"><span>Duração</span><select name="durationMinutes"><option value="30">30 minutos</option><option value="45">45 minutos</option><option value="60" selected>60 minutos</option><option value="90">90 minutos</option></select></label><label class="form-field"><span>Modalidade</span><select name="mode"><option value="in_person">Presencial</option><option value="online">Online</option></select></label><label class="form-field form-span-2"><span>Tipo de consulta</span><input name="type" required value="Consulta de acompanhamento"></label><label class="form-field form-span-2"><span>Observações</span><textarea name="notes" rows="3"></textarea></label></div></div><footer class="dialog-footer"><button class="button button-secondary" type="button" data-dialog-close>Cancelar</button><button class="button button-primary" type="submit">Agendar consulta</button></footer></form></dialog>
  <% } else if (moduleKey === 'diets') { %>
    <div class="diet-summary-strip"><span><small>PLANOS ATIVOS</small><strong><%= mealPlans.filter((plan) => plan.status === 'published').length %></strong></span><span><small>RASCUNHOS</small><strong><%= mealPlans.filter((plan) => plan.status === 'draft').length %></strong></span><span><small>REFEIÇÕES CADASTRADAS</small><strong><%= mealPlans.reduce((total, plan) => total + plan.meals.length, 0) %></strong></span><span><small>ALIMENTOS DISPONÍVEIS</small><strong><%= foods.length %></strong></span></div>
    <div class="plan-grid">
      <% mealPlans.forEach((plan) => { const patient = allPatients.find((item) => item.id === plan.patientId); const totals = plan.meals.reduce((sum, meal) => ({ kcal: sum.kcal + meal.kcal, protein: sum.protein + meal.proteinG }), { kcal: 0, protein: 0 }); %>
        <article class="plan-card"><header><span class="plan-status <%= plan.status %>"><%= plan.status === 'published' ? 'Publicado' : 'Rascunho' %></span><small>VERSÃO <%= plan.version %></small></header><h2><%= plan.title %></h2><p><%= patient?.fullName ?? 'Paciente não encontrado' %> · <%= plan.goal %></p><div class="plan-macros"><span><small>ENERGIA</small><b><%= totals.kcal %> kcal</b><i><%= Math.round(totals.kcal / plan.kcalTarget * 100) %>% da meta</i></span><span><small>PROTEÍNA</small><b><%= totals.protein %> g</b><i>meta <%= plan.proteinTargetG %> g</i></span></div><footer><span><%= plan.meals.length %> refeições</span><button type="button" data-dialog-open="plan-<%= plan.id %>">Editar plano →</button></footer></article>

        <dialog class="app-dialog plan-dialog" id="plan-<%= plan.id %>" aria-labelledby="plan-<%= plan.id %>-title"><div class="patient-dialog-shell"><header class="dialog-header"><div><p class="eyebrow">PLANO ALIMENTAR · VERSÃO <%= plan.version %></p><h2 id="plan-<%= plan.id %>-title"><%= plan.title %></h2></div><button class="dialog-close" type="button" data-dialog-close>×</button></header><div class="dialog-body"><div class="plan-dialog-meta"><span><small>PACIENTE</small><b><%= patient?.fullName %></b></span><span><small>PERÍODO</small><b><%= plan.startsOn.split('-').reverse().join('/') %> — <%= plan.endsOn.split('-').reverse().join('/') %></b></span><span><small>META</small><b><%= plan.kcalTarget %> kcal</b></span></div><div class="meal-timeline"><% plan.meals.forEach((meal, mealIndex) => { %><article><span><b><%= String(mealIndex + 1).padStart(2, '0') %></b><i></i></span><time><%= meal.scheduledTime %></time><div><strong><%= meal.name %></strong><p><%= meal.description %></p><small><%= meal.kcal %> kcal · <%= meal.proteinG %>g proteína · <%= meal.carbsG %>g carbo · <%= meal.fatG %>g gordura</small></div></article><% }) %></div><button class="add-inline-button" type="button" data-dialog-open="meal-<%= plan.id %>">＋ Adicionar refeição</button></div><footer class="dialog-footer"><% if (plan.status === 'draft') { %><form method="post" action="/diets/<%= plan.id %>/publish"><button class="button button-secondary" type="submit">Publicar plano</button></form><% } %><button class="button button-primary" type="button" data-dialog-close>Concluir</button></footer></div></dialog>

        <dialog class="app-dialog" id="meal-<%= plan.id %>" aria-labelledby="meal-<%= plan.id %>-title"><form method="post" action="/diets/meals"><input type="hidden" name="planId" value="<%= plan.id %>"><header class="dialog-header"><div><p class="eyebrow">NOVA REFEIÇÃO</p><h2 id="meal-<%= plan.id %>-title"><%= plan.title %></h2></div><button class="dialog-close" type="button" data-dialog-close>×</button></header><div class="dialog-body"><div class="form-grid"><label class="form-field"><span>Nome da refeição</span><input name="name" required placeholder="Ex.: Ceia"></label><label class="form-field"><span>Horário</span><input name="scheduledTime" type="time" required></label><label class="form-field form-span-2"><span>Alimentos e observações</span><textarea name="description" required rows="3" placeholder="Descreva os alimentos, quantidades e medidas caseiras."></textarea></label><label class="form-field"><span>Energia (kcal)</span><input name="kcal" type="number" min="0" required></label><label class="form-field"><span>Proteínas (g)</span><input name="proteinG" type="number" min="0" step="0.1" required></label><label class="form-field"><span>Carboidratos (g)</span><input name="carbsG" type="number" min="0" step="0.1" required></label><label class="form-field"><span>Gorduras (g)</span><input name="fatG" type="number" min="0" step="0.1" required></label></div></div><footer class="dialog-footer"><button class="button button-secondary" type="button" data-dialog-close>Cancelar</button><button class="button button-primary" type="submit">Salvar refeição</button></footer></form></dialog>
      <% }) %>
    </div>
    <dialog class="app-dialog" id="new-plan" aria-labelledby="new-plan-title"><form method="post" action="/diets"><header class="dialog-header"><div><p class="eyebrow">NOVO PLANO</p><h2 id="new-plan-title">Criar plano alimentar</h2></div><button class="dialog-close" type="button" data-dialog-close>×</button></header><div class="dialog-body"><div class="form-grid"><label class="form-field form-span-2"><span>Paciente</span><select name="patientId" required><option value="">Selecione</option><% allPatients.forEach((patient) => { %><option value="<%= patient.id %>"><%= patient.fullName %></option><% }) %></select></label><label class="form-field form-span-2"><span>Título</span><input name="title" required placeholder="Ex.: Plano de reeducação alimentar"></label><label class="form-field form-span-2"><span>Objetivo</span><input name="goal" required></label><label class="form-field"><span>Início</span><input name="startsOn" type="date" required></label><label class="form-field"><span>Término</span><input name="endsOn" type="date" required></label><label class="form-field"><span>Meta energética (kcal)</span><input name="kcalTarget" type="number" min="500" value="2000" required></label><label class="form-field"><span>Meta de proteína (g)</span><input name="proteinTargetG" type="number" min="0" value="120" required></label></div></div><footer class="dialog-footer"><button class="button button-secondary" type="button" data-dialog-close>Cancelar</button><button class="button button-primary" type="submit">Criar plano</button></footer></form></dialog>
  <% } else if (moduleKey === 'foods') { %>
    <div class="module-toolbar"><label><span>⌕</span><input type="search" placeholder="Buscar alimento..." data-food-search></label><button class="module-filter active">Todos <b><%= foods.length %></b></button><button class="module-filter">TACO</button><button class="module-filter">Personalizados</button></div>
    <div class="food-table"><div class="food-table-head"><span>Alimento</span><span>Fonte</span><span>Porção</span><span>Energia</span><span>Proteína</span><span>Carboidrato</span><span>Gordura</span></div><% foods.forEach((food) => { %><article data-food-name="<%= food.name.toLowerCase() %>"><span><strong><%= food.name %></strong><small><%= food.reviewed ? '✓ Revisado' : 'Revisão pendente' %></small></span><b class="food-source"><%= food.source %></b><span><%= food.servingGrams %> g</span><span><%= food.kcal %> kcal</span><span><%= food.proteinG %> g</span><span><%= food.carbsG %> g</span><span><%= food.fatG %> g</span></article><% }) %></div>
    <dialog class="app-dialog" id="new-food" aria-labelledby="new-food-title"><form method="post" action="/foods"><header class="dialog-header"><div><p class="eyebrow">ALIMENTO PERSONALIZADO</p><h2 id="new-food-title">Cadastrar alimento</h2></div><button class="dialog-close" type="button" data-dialog-close>×</button></header><div class="dialog-body"><div class="form-grid"><label class="form-field form-span-2"><span>Nome</span><input name="name" required></label><label class="form-field"><span>Porção de referência (g)</span><input name="servingGrams" type="number" min="1" value="100" required></label><label class="form-field"><span>Energia (kcal)</span><input name="kcal" type="number" min="0" required></label><label class="form-field"><span>Proteínas (g)</span><input name="proteinG" type="number" min="0" step="0.1" required></label><label class="form-field"><span>Carboidratos (g)</span><input name="carbsG" type="number" min="0" step="0.1" required></label><label class="form-field"><span>Gorduras (g)</span><input name="fatG" type="number" min="0" step="0.1" required></label><label class="form-field"><span>Fibras (g)</span><input name="fiberG" type="number" min="0" step="0.1" required></label></div></div><footer class="dialog-footer"><button class="button button-secondary" type="button" data-dialog-close>Cancelar</button><button class="button button-primary" type="submit">Salvar alimento</button></footer></form></dialog>
  <% } else if (moduleKey === 'finance') { %>
    <% const receivedCents = payments.filter((item) => item.status === 'paid').reduce((sum, item) => sum + item.amountCents, 0); const pendingCents = payments.filter((item) => ['pending', 'overdue'].includes(item.status)).reduce((sum, item) => sum + item.amountCents, 0); const paymentLabels = { pending: 'Pendente', paid: 'Pago', overdue: 'Vencido', cancelled: 'Cancelado', refunded: 'Estornado' }; %>
    <div class="ops-summary finance"><span><small>RECEBIDO</small><strong><%= (receivedCents / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong></span><span><small>A RECEBER</small><strong><%= (pendingCents / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></strong></span><span><small>LANÇAMENTOS</small><strong><%= payments.length %></strong></span></div>
    <div class="operations-table"><div class="operations-head"><span>Paciente</span><span>Plano</span><span>Vencimento</span><span>Valor</span><span>Status</span><span>Ação</span></div><% payments.forEach((payment) => { const patient = allPatients.find((item) => item.id === payment.patientId); %><article><span><strong><%= patient?.fullName ?? 'Paciente não encontrado' %></strong><small><%= payment.method %></small></span><span><%= payment.plan %></span><span><%= payment.dueDate.split('-').reverse().join('/') %></span><b><%= (payment.amountCents / 100).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></b><i class="operation-status <%= payment.status %>"><%= paymentLabels[payment.status] %></i><form class="row-actions" method="post" action="/payments/<%= payment.id %>/status"><select name="status" aria-label="Alterar status"><option value="paid">Marcar pago</option><option value="pending">Pendente</option><option value="overdue">Vencido</option><option value="cancelled">Cancelar</option><option value="refunded">Estornar</option></select><button type="submit">Salvar</button></form></article><% }) %></div>
    <dialog class="app-dialog" id="new-payment" aria-labelledby="new-payment-title"><form method="post" action="/payments"><header class="dialog-header"><div><p class="eyebrow">FINANCEIRO</p><h2 id="new-payment-title">Novo lançamento</h2></div><button class="dialog-close" type="button" data-dialog-close>×</button></header><div class="dialog-body"><div class="form-grid"><label class="form-field form-span-2"><span>Paciente</span><select name="patientId" required><option value="">Selecione</option><% allPatients.forEach((patient) => { %><option value="<%= patient.id %>"><%= patient.fullName %></option><% }) %></select></label><label class="form-field form-span-2"><span>Plano ou serviço</span><input name="plan" required value="Consulta individual"></label><label class="form-field"><span>Valor (R$)</span><input name="amount" type="number" min="0.01" step="0.01" required></label><label class="form-field"><span>Vencimento</span><input name="dueDate" type="date" required></label><label class="form-field"><span>Forma de pagamento</span><select name="method"><option>Pix</option><option>Cartão</option><option>Boleto</option><option>Dinheiro</option></select></label><label class="form-field"><span>Status</span><select name="status"><option value="pending">Pendente</option><option value="paid">Pago</option><option value="overdue">Vencido</option></select></label><input name="paidOn" type="hidden" value=""><label class="form-field form-span-2"><span>Observações</span><textarea name="notes" rows="3"></textarea></label></div></div><footer class="dialog-footer"><button class="button button-secondary" type="button" data-dialog-close>Cancelar</button><button class="button button-primary" type="submit">Salvar lançamento</button></footer></form></dialog>
  <% } else if (moduleKey === 'documents') { %>
    <div class="ops-summary"><span><small>DOCUMENTOS</small><strong><%= documents.length %></strong></span><span><small>DISPONÍVEIS</small><strong><%= documents.filter((item) => item.status === 'available').length %></strong></span><span><small>RASCUNHOS</small><strong><%= documents.filter((item) => item.status === 'draft').length %></strong></span></div>
    <div class="document-grid"><% documents.forEach((document) => { const patient = allPatients.find((item) => item.id === document.patientId); %><article><span class="document-icon">DOC</span><div><small><%= document.type %></small><strong><%= document.title %></strong><p><%= patient?.fullName ?? 'Paciente não encontrado' %> · <%= document.createdOn.split('-').reverse().join('/') %></p></div><a class="button button-secondary" href="/documents/<%= document.id %>/download">Baixar arquivo</a></article><% }) %></div>
    <dialog class="app-dialog" id="new-document" aria-labelledby="new-document-title"><form method="post" action="/documents"><header class="dialog-header"><div><p class="eyebrow">DOCUMENTOS</p><h2 id="new-document-title">Gerar documento clínico</h2></div><button class="dialog-close" type="button" data-dialog-close>×</button></header><div class="dialog-body"><div class="form-grid"><label class="form-field form-span-2"><span>Paciente</span><select name="patientId" required><option value="">Selecione</option><% allPatients.forEach((patient) => { %><option value="<%= patient.id %>"><%= patient.fullName %></option><% }) %></select></label><label class="form-field form-span-2"><span>Título</span><input name="title" required placeholder="Ex.: Relatório de evolução"></label><label class="form-field"><span>Tipo</span><select name="type"><option>Relatório de evolução</option><option>Plano alimentar</option><option>Avaliação física</option><option>Termo de consentimento</option></select></label><label class="form-field"><span>Data</span><input name="createdOn" type="date" required></label></div></div><footer class="dialog-footer"><button class="button button-secondary" type="button" data-dialog-close>Cancelar</button><button class="button button-primary" type="submit">Gerar documento</button></footer></form></dialog>
  <% } else if (moduleKey === 'messages') { %>
    <div class="messaging-shell">
      <aside class="conversation-list"><header><strong>Conversas</strong><small><%= allPatients.length %> pacientes</small></header><nav><% allPatients.forEach((patient) => { const last = chatMessages.filter((message) => message.patientId === patient.id).at(-1); %><a class="<%= selectedChatPatient?.id === patient.id ? 'active' : '' %>" href="/messages?patient=<%= patient.id %>"><span class="patient-avatar green"><%= patient.fullName.split(' ').slice(0,2).map((name) => name[0]).join('') %></span><span><strong><%= patient.fullName %></strong><small><%= last?.body ?? patient.goal %></small></span><% if (unreadByPatient[patient.id]) { %><b><%= unreadByPatient[patient.id] %></b><% } %></a><% }) %></nav></aside>
      <section class="chat-panel"><header><div><strong><%= selectedChatPatient?.fullName %></strong><small><span class="status-dot"></span> Acompanhamento ativo</small></div><% if (selectedChatPatient && unreadByPatient[selectedChatPatient.id]) { %><form method="post" action="/messages/<%= selectedChatPatient.id %>/read"><button class="button button-secondary" type="submit">Marcar como lidas</button></form><% } %></header><div class="chat-stream"><% chatMessages.forEach((message) => { %><article class="chat-bubble <%= message.author %>"><p><%= message.body %></p><time><%= message.sentAt.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }) %><%= message.author === 'nutritionist' ? ' · Enviada' : '' %></time></article><% }) %><% if (!chatMessages.length) { %><div class="empty-chat"><strong>Comece uma conversa</strong><small>As mensagens ficam disponíveis durante esta execução local.</small></div><% } %></div><% if (selectedChatPatient) { %><form class="chat-composer" method="post" action="/messages"><input type="hidden" name="patientId" value="<%= selectedChatPatient.id %>"><textarea name="body" rows="2" maxlength="2000" required placeholder="Escreva uma mensagem para <%= selectedChatPatient.fullName.split(' ')[0] %>..."></textarea><button class="button button-primary" type="submit">Enviar</button></form><% } %></section>
    </div>
  <% } else if (moduleKey === 'settings') { %>
    <form class="settings-layout" method="post" action="/settings"><section><header><p class="eyebrow">PERFIL PROFISSIONAL</p><h2>Dados do consultório</h2><small>Essas informações identificam o nutricionista responsável.</small></header><div class="form-grid"><label class="form-field"><span>Nome completo</span><input name="name" value="<%= settings.name %>" required></label><label class="form-field"><span>Registro profissional</span><input name="crn" value="<%= settings.crn %>" required></label><label class="form-field"><span>E-mail</span><input name="email" type="email" value="<%= settings.email %>" required></label><label class="form-field"><span>Telefone</span><input name="phone" value="<%= settings.phone %>" required></label><label class="form-field"><span>Duração padrão da consulta</span><select name="consultationDuration"><% [30,45,60,90].forEach((minutes) => { %><option value="<%= minutes %>" <%= settings.consultationDuration === minutes ? 'selected' : '' %>><%= minutes %> minutos</option><% }) %></select></label></div></section><aside><div><p class="eyebrow">NOTIFICAÇÕES</p><h2>Alertas internos</h2><label class="toggle-row"><span><strong>Consultas</strong><small>Lembretes da agenda</small></span><input name="notifyAppointments" type="checkbox" <%= settings.notifyAppointments ? 'checked' : '' %>></label><label class="toggle-row"><span><strong>Mensagens</strong><small>Conversas não lidas</small></span><input name="notifyMessages" type="checkbox" <%= settings.notifyMessages ? 'checked' : '' %>></label><label class="toggle-row"><span><strong>Financeiro</strong><small>Vencimentos e atrasos</small></span><input name="notifyPayments" type="checkbox" <%= settings.notifyPayments ? 'checked' : '' %>></label></div><div class="security-card"><span>SESSÃO LOCAL</span><strong>Proteção de acesso será ativada antes da conexão ao banco.</strong><small>Helmet e validação de entradas já estão ativos.</small></div></aside><footer><button class="button button-primary" type="submit">Salvar configurações</button></footer></form>
  <% } else { %>
    <div class="module-coming-soon"><span><%= selectedModule.phase.replace('Fase ', '') %></span><p class="eyebrow">ESTRUTURA PREPARADA</p><h2>Este módulo será conectado ao banco na <%= selectedModule.phase %>.</h2><p>A navegação principal já está no lugar. As regras, formulários e permissões serão implementados sem atalhos na etapa correspondente.</p><a class="button button-secondary" href="/">Voltar à visão geral</a></div>
  <% } %>
</section>

<% if (notice === 'appointment-created') { %><div class="toast toast-success" role="status" data-toast><b>✓</b><span><strong>Consulta agendada</strong><small>O compromisso já aparece na agenda local.</small></span><button type="button" data-toast-close>×</button></div><% } %>
<% if (notice === 'appointment-status') { %><div class="toast toast-success" role="status" data-toast><b>✓</b><span><strong>Consulta atualizada</strong><small>O novo status foi aplicado.</small></span><button type="button" data-toast-close>×</button></div><% } %>
<% if (notice === 'payment-created') { %><div class="toast toast-success" role="status" data-toast><b>✓</b><span><strong>Lançamento salvo</strong><small>O financeiro foi atualizado localmente.</small></span><button type="button" data-toast-close>×</button></div><% } %>
<% if (notice === 'payment-status') { %><div class="toast toast-success" role="status" data-toast><b>✓</b><span><strong>Pagamento atualizado</strong><small>O novo status financeiro foi aplicado.</small></span><button type="button" data-toast-close>×</button></div><% } %>
<% if (notice === 'document-created') { %><div class="toast toast-success" role="status" data-toast><b>✓</b><span><strong>Documento gerado</strong><small>O arquivo está disponível para download.</small></span><button type="button" data-toast-close>×</button></div><% } %>
<% if (notice === 'message-sent') { %><div class="toast toast-success" role="status" data-toast><b>✓</b><span><strong>Mensagem enviada</strong><small>A conversa foi atualizada.</small></span><button type="button" data-toast-close>×</button></div><% } %>
<% if (notice === 'messages-read') { %><div class="toast toast-success" role="status" data-toast><b>✓</b><span><strong>Mensagens lidas</strong><small>As notificações desta conversa foram limpas.</small></span><button type="button" data-toast-close>×</button></div><% } %>
<% if (notice === 'settings-saved') { %><div class="toast toast-success" role="status" data-toast><b>✓</b><span><strong>Configurações salvas</strong><small>O perfil e os alertas foram atualizados.</small></span><button type="button" data-toast-close>×</button></div><% } %>

<% if (notice === 'created') { %><div class="toast toast-success" role="status" data-toast><b>✓</b><span><strong>Paciente salvo</strong><small><%= patientName %> foi adicionado ao acompanhamento local.</small></span><button type="button" data-toast-close>×</button></div><% } %>
<% if (notice === 'status') { %><div class="toast toast-success" role="status" data-toast><b>✓</b><span><strong>Status atualizado</strong><small>O acompanhamento de <%= patientName %> foi atualizado.</small></span><button type="button" data-toast-close>×</button></div><% } %>
<% if (notice === 'assessment') { %><div class="toast toast-success" role="status" data-toast><b>✓</b><span><strong>Avaliação salva</strong><small>Os indicadores e o histórico foram atualizados.</small></span><button type="button" data-toast-close>×</button></div><% } %>
<% if (notice === 'plan-created') { %><div class="toast toast-success" role="status" data-toast><b>✓</b><span><strong>Plano criado</strong><small>O novo plano está disponível como rascunho.</small></span><button type="button" data-toast-close>×</button></div><% } %>
<% if (notice === 'meal-created') { %><div class="toast toast-success" role="status" data-toast><b>✓</b><span><strong>Refeição adicionada</strong><small>Os totais nutricionais foram recalculados.</small></span><button type="button" data-toast-close>×</button></div><% } %>
<% if (notice === 'published') { %><div class="toast toast-success" role="status" data-toast><b>✓</b><span><strong>Plano publicado</strong><small>A versão está marcada como disponível para o paciente.</small></span><button type="button" data-toast-close>×</button></div><% } %>
<% if (notice === 'food-created') { %><div class="toast toast-success" role="status" data-toast><b>✓</b><span><strong>Alimento salvo</strong><small>O item personalizado está disponível para uso local.</small></span><button type="button" data-toast-close>×</button></div><% } %>
<% if (errorMessage) { %><div class="toast toast-error" role="alert" data-toast><b>!</b><span><strong>Não foi possível salvar</strong><small><%= errorMessage %></small></span><button type="button" data-toast-close>×</button></div><% } %>
<%- include('../partials/alert', { tone: 'info', title: 'Armazenamento temporário local.', message: 'As alterações funcionam durante esta execução do servidor; o PostgreSQL será conectado na etapa final.' }) %>
