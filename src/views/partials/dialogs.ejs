<dialog class="app-dialog" id="new-patient" aria-labelledby="new-patient-title">
  <form method="post" action="/patients">
    <header class="dialog-header">
      <div><p class="eyebrow">NOVO PRONTUÁRIO</p><h2 id="new-patient-title">Adicionar paciente</h2></div>
      <button class="dialog-close" type="button" data-dialog-close aria-label="Fechar">×</button>
    </header>
    <div class="dialog-body">
      <div class="dialog-section-title"><span>01</span><div><strong>Dados pessoais</strong><small>Informações básicas para contato e identificação.</small></div></div>
      <div class="form-grid">
        <label class="form-field form-span-2"><span>Nome completo</span><input name="fullName" autocomplete="name" required maxlength="120" placeholder="Ex.: Ana Martins"></label>
        <label class="form-field"><span>E-mail</span><input name="email" type="email" autocomplete="email" required placeholder="paciente@email.com"></label>
        <label class="form-field"><span>Telefone</span><input name="phone" autocomplete="tel" required placeholder="(11) 99999-9999"></label>
        <label class="form-field"><span>Data de nascimento</span><input name="birthDate" type="date" required></label>
        <label class="form-field"><span>Nível de atividade</span><select name="activityLevel" required><option value="">Selecione</option><option>Sedentário</option><option>Leve</option><option>Moderado</option><option>Intenso</option><option>Muito intenso</option></select></label>
        <label class="form-field"><span>Altura (cm)</span><input name="heightCm" type="number" min="30" max="260" step="0.1" placeholder="165"></label>
        <label class="form-field"><span>Peso inicial (kg)</span><input name="initialWeightKg" type="number" min="1" max="500" step="0.1" placeholder="68,5"></label>
      </div>
      <div class="dialog-section-title"><span>02</span><div><strong>Acompanhamento</strong><small>Objetivo e observações iniciais.</small></div></div>
      <div class="form-grid">
        <label class="form-field form-span-2"><span>Objetivo principal</span><input name="goal" required maxlength="160" placeholder="Ex.: Emagrecimento com manutenção de massa magra"></label>
        <label class="form-field form-span-2"><span>Observações</span><textarea name="notes" rows="4" maxlength="2000" placeholder="Restrições, rotina ou pontos importantes para a primeira consulta."></textarea></label>
      </div>
    </div>
    <footer class="dialog-footer"><button class="button button-secondary" type="button" data-dialog-close>Cancelar</button><button class="button button-primary" type="submit">Salvar paciente</button></footer>
  </form>
</dialog>
