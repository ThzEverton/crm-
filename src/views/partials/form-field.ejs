<label class="form-field">
  <span><%= label %></span>
  <input type="<%= typeof type !== 'undefined' ? type : 'text' %>" name="<%= name %>" value="<%= typeof value !== 'undefined' ? value : '' %>" <%= typeof required !== 'undefined' && required ? 'required' : '' %>>
  <% if (typeof hint !== 'undefined') { %><small><%= hint %></small><% } %>
</label>
